---
import {getEntry, render} from 'astro:content';
import Layout from '@/layouts/Layout.astro';

export function getStaticPaths() {
  return [
    {params: {locale: 'en'}},
    {params: {locale: 'id'}},
  ];
}

const {locale} = Astro.params;
const now = locale ? await getEntry('now', locale) : undefined;

if (!now) {
  return Astro.redirect(`/${locale}`);
}

const {Content} = await render(now);
---

<Layout locale={locale} title={`Now | Djoni's Den`}>
  <div class="min-h-screen pt-24 pb-16">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <header class="mb-12 text-center">
        <p class="text-sm font-medium text-neon-purple mb-3 tracking-wider uppercase">
          Current Focus
        </p>
        <h1 class="text-4xl md:text-6xl font-bold mb-4">
          <span class="bg-gradient-neon bg-clip-text text-transparent">What I'm Doing Now</span>
        </h1>
        <p class="text-gray-400 max-w-xl mx-auto text-lg">
          A glimpse into my current activities, projects, and focus areas.
        </p>
      </header>

      <div class="bg-dark-card/50 border border-white/5 rounded-2xl p-8 md:p-12 mb-8 reveal">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-white mb-2">{now.data.title}</h2>
          <p class="text-sm text-gray-500">
            Last Updated: <span class="text-neon-purple">{now.data.date}</span>
          </p>
        </div>

        <div class="prose prose-invert prose-lg max-w-none text-gray-300">
          <Content />
        </div>
      </div>

      <div class="text-center reveal reveal-delay-1">
        <p class="text-gray-500 text-sm">
          This is a{' '}
          <a
            href="https://nownownow.com/about"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neon-purple hover:underline"
          >
            now page
          </a>
          . If you have your own site, consider making one too.
        </p>
      </div>
    </div>
  </div>
</Layout>

---
import {getEntry, render} from 'astro:content';
import Layout from '@/layouts/Layout.astro';

export function getStaticPaths() {
  return [
    {params: {locale: 'en'}},
    {params: {locale: 'id'}},
  ];
}

const {locale} = Astro.params;
const about = locale ? await getEntry('about', locale) : undefined;

if (!about) {
  return Astro.redirect(`/${locale}`);
}

const {Content} = await render(about);

const techStack = [
  {name: 'React', category: 'Frontend'},
  {name: 'Next.js', category: 'Frontend'},
  {name: 'TypeScript', category: 'Frontend'},
  {name: 'Tailwind CSS', category: 'Frontend'},
  {name: 'Astro', category: 'Frontend'},
  {name: 'Flutter', category: 'Mobile'},
  {name: 'Dart', category: 'Mobile'},
  {name: 'Laravel', category: 'Backend'},
  {name: 'Express.js', category: 'Backend'},
  {name: 'Node.js', category: 'Backend'},
  {name: 'PostgreSQL', category: 'Database'},
  {name: 'Docker', category: 'DevOps'},
  {name: 'Git', category: 'Tools'},
  {name: 'Biome', category: 'Tools'},
];
---

<Layout locale={locale} title={`About Me | Djoni's Den`}>
  <div class="min-h-screen pt-24 pb-16">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <!-- Header -->
      <header class="mb-12 text-center">
        <p class="text-sm font-medium text-neon-purple mb-3 tracking-wider uppercase">
          {locale === 'id' ? 'Siapa Gue' : 'Who I Am'}
        </p>
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          <span class="bg-gradient-neon bg-clip-text text-transparent">
            {locale === 'id' ? 'Tentang Saya' : 'About Me'}
          </span>
        </h1>
        <div class="flex flex-col items-center gap-2">
          <h2 class="text-2xl font-bold text-white">
            Alvin Leonardo <span class="bg-gradient-neon bg-clip-text text-transparent">Djoni</span>
          </h2>
          <p class="text-neon-purple font-medium">
            {locale === 'id' ? 'Software Engineer' : 'Software Engineer'}
          </p>
          <p class="text-gray-500 text-sm">
            {locale === 'id' ? 'System Development Staff di Thamrin Group' : 'System Development Staff at Thamrin Group'}
          </p>
        </div>
      </header>

      <!-- Content -->
      <div class="bg-dark-card/50 border border-white/5 rounded-2xl p-8 md:p-12 mb-8 reveal">
        <div class="prose prose-invert prose-lg max-w-none text-gray-300">
          <Content />
        </div>
      </div>

      <!-- Tech Stack -->
      <div class="mb-12 reveal reveal-delay-1">
        <h3 class="text-lg font-semibold text-white mb-4 text-center">
          {locale === 'id' ? 'Tech Stack' : 'Tech Stack'}
        </h3>
        <div class="flex flex-wrap justify-center gap-2">
          {techStack.map((tech) => (
            <span class="px-3 py-1.5 text-sm font-medium rounded-lg bg-dark-card/50 border border-white/5 text-gray-400 hover:text-neon-purple hover:border-neon-purple/30 transition-all duration-200">
              {tech.name}
            </span>
          ))}
        </div>
      </div>

      <!-- Social Links -->
      <div class="flex flex-wrap justify-center gap-4 reveal reveal-delay-2">
        <a
          href="https://github.com/alvinvin00"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl border border-gray-800 text-gray-400 hover:text-white hover:border-neon-purple/30 transition-all duration-300 focus-ring"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/alvinleonardo"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl bg-gradient-neon text-white hover:shadow-neon-purple-lg transition-all duration-300 focus-ring"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</Layout>

---
import {SiGithub} from '@icons-pack/react-simple-icons';
import {getCollection, render} from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import dayjs from 'dayjs';
import {ExternalLink} from 'lucide-react';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: {locale: project.data.lang, slug: project.data.slug},
  }));
}

const {locale, slug} = Astro.params;
const projects = await getCollection('projects');
const project = projects.find(
  (p) => p.data.slug === slug && p.data.lang === locale,
);

if (!project) {
  return Astro.redirect(`/${locale}/projects`);
}

const {Content} = await render(project);
---

<Layout locale={locale} title={`${project.data.title} | Projects | Djoni's Den`}>
  <article class="min-h-screen pt-24 pb-16">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8">
        <a
          href={`/${locale}/projects`}
          class="text-sm text-gray-500 hover:text-neon-purple transition-colors inline-flex items-center gap-1"
          data-astro-prefetch
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Projects
        </a>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          {project.data.tags?.map((tag: string) => (
            <span class="px-3 py-1 text-xs font-medium rounded-full bg-white/5 text-gray-400 border border-white/10">
              {tag}
            </span>
          ))}
        </div>

        <h1 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
          {project.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 mb-6">
          <time class="text-sm text-gray-500">
            {dayjs(project.data.date).format('MMMM D, YYYY')}
          </time>
          {project.data.status && (
            <span
              class={`px-3 py-1 text-xs font-medium rounded-full ${
                project.data.status === 'active'
                  ? 'bg-green-500/10 text-green-400 border border-green-500/20'
                  : project.data.status === 'handed-off'
                    ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20'
                    : project.data.status === 'completed'
                      ? 'bg-purple-500/10 text-purple-400 border border-purple-500/20'
                      : 'bg-gray-500/10 text-gray-500 border border-gray-500/20'
              }`}
            >
              {project.data.status === 'handed-off'
                ? 'Handed Off'
                : project.data.status === 'completed'
                  ? 'Completed'
                  : project.data.status === 'archived'
                    ? 'Archived'
                    : 'Active'}
            </span>
          )}
        </div>

        <div class="flex flex-wrap gap-3">
          {project.data.github && (
            <a
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-gray-300 hover:text-white hover:border-neon-purple/30 transition-all text-sm"
            >
              <SiGithub className="w-4 h-4" />
              View Code
            </a>
          )}
          {project.data.link && (
            <a
              href={project.data.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-neon text-white text-sm hover:shadow-neon-purple-lg transition-all"
            >
              <ExternalLink className="w-4 h-4" />
              Live Demo
            </a>
          )}
        </div>
      </header>

      {project.data.thumbnail && (
        <div class="mb-10 rounded-2xl overflow-hidden border border-white/5">
          <img
            src={project.data.thumbnail}
            alt={project.data.title}
            class="w-full h-auto"
          />
        </div>
      )}

      <!-- Content -->
      <div class="prose prose-invert prose-lg max-w-none">
        <Content />
      </div>
    </div>
  </article>
</Layout>
